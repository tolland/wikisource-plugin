{
  parserClass="org.limepepper.lang.wikitext.parser.WtParser"
  parserUtilClass="org.limepepper.lang.wikitext.parser.WtParserUtil"
  psiImplUtilClass="org.limepepper.lang.wikitext.parser.WtPsiImplUtil"
  psiClassPrefix="Wt"
  psiImplClassSuffix="Impl"

  psiPackage="org.limepepper.lang.wikitext.psi"
  extends = 'com.intellij.extapi.psi.ASTWrapperPsiElement'
  psiImplPackage="org.limepepper.lang.wikitext.psi.impl"
  implements = 'com.intellij.psi.NavigatablePsiElement'

  elementTypeClass="org.limepepper.lang.wikitext.psi.WtElementType"
  elementTypeHolderClass="org.limepepper.lang.wikitext.psi.WtTypes"
  tokenTypeClass="org.limepepper.lang.wikitext.psi.WtTokenType"

  // ---------------------------------------------------------------------
  // Token set below is the EXACT set WtLexer.flex actually returns -- see
  // lexer_emitted_tokens.txt cross-reference. Every entry here has a
  // corresponding `return WtTypes.X` somewhere in the .flex. Do not add a
  // token here unless the lexer emits it; do not let any name here collide
  // with a rule name below (Grammar-Kit generates both into the same
  // WtTypes class, and a collision means the lexer's leaf token gets
  // silently replaced by the rule's composite WtElementType -- this is
  // the exact bug that motivated this rewrite: HEADING_LINE, LINK_TARGET,
  // and TEMPLATE_NAME were previously BOTH lexer tokens AND rule names).
  tokens=[
    LBRACK='['
    RBRACK=']'

    FIVE_APOS="regexp:'''''"
    THREE_APOS="regexp:'''"
    TWO_APOS="regexp:''"
    SINGLE_APOS="regexp:'"

    // NOTE: PIPE (flat), EQUALS, H1_START..H6_START, and NUMBER (old name
    // for NUMBERED) were here as placeholders from the pre-frame-stack
    // grammar. Removed entirely now that the lexer has real, working
    // replacements (TEMPLATE_PIPE/LINK_PIPE/TABLE_CELL_SEP, H_START/H_END,
    // NUMBERED) -- leaving superseded tokens declared was actively
    // misleading, not just unused, since they describe a design the
    // lexer no longer implements.

    BULLET='*'
    NUMBERED='#'
    INDENT=':'
    DEF_TERM=';'

    NEWLINE='regexp:\r?\n'
    SPACE='regexp:\s+'
    PLAIN_TEXT="regexp:[^\s\[\]{}|=']+"

    HTML_TAG_CLOSE='regexp:</[a-zA-Z][a-zA-Z0-9]*\s*>'
    HTML_TAG_OPEN='regexp:<[a-zA-Z][a-zA-Z0-9]*[^>]*>'
    HTML_TAG_SELFCLOSE='regexp:<[a-zA-Z][a-zA-Z0-9]*[^>]*/>'
    LINK_OPEN='[['
    LINK_CLOSE=']]'
    LINK_DISPLAY_TEXT='regexp:[^]{|<]+'
    OPEN_TAG_HEAD='regexp:<[a-zA-Z][a-zA-Z0-9]*'
    // wikitable
    TABLE_CELL_SEP='|'
    TABLE_CELL_TEXT='regexp:[^{}\[\]|<]+'
    TABLE_CLOSE='TABLE_CLOSE["|}"]'
    TABLE_OPEN='TABLE_OPEN["{|"]'
    // template
    TEMPLATE_CLOSE='}}'
    TEMPLATE_EQUALS='TEMPLATE_EQUALS[=]'
    TEMPLATE_OPEN='{{'
    TEMPLATE_PARAM_TEXT='regexp:[^{}|=\[<]+'
    // <nowiki></nowiki>
    VERBATIM_CONTENT='regexp:[^<]+|<'

    // Previously these collided with .bnf RULE names of the same text
    // (link_target, template_name) -- the root cause of the original bug.
    // They are tokens now; no rule below may share these names
    // (case-insensitively).
    LINK_TARGET='regexp:[^]|]+'
    TEMPLATE_NAME='regexp:[^{}|]+'

    // Heading open/close markers -- see WikitextLexer.flex's H_START macro
    // comment for why headings are no longer matched as one whole-line
    // HEADING_LINE token. H_START opens a HEADING frame; H_END only fires
    // when that frame is on top of the stack AND immediately followed by
    // line-end, so content (including nested templates/tags/links) is
    // lexed with full frame-awareness rather than swallowed by a regex.
    H_START='regexp:[ \t]{0,3}={1,6}'
    H_END='regexp:={1,6}[ \t]*'

    // PIPE now comes in three context-specific flavors, decided by
    // WtLexer.pipeTokenForContext() based on which frame is on top of the
    // stack -- see project discussion on why a flat PIPE can't disambiguate
    // "next template param" vs "next link param" vs "next table cell".
    TEMPLATE_PIPE='|'
    LINK_PIPE='|'

    // List marker, renamed from NUMBER to avoid ambiguity with numeric
    // literal conventions elsewhere -- matches WtLexer.flex's "{LINE_WS}{0,3} '#'+" rule.

    // Lexer-detected mismatched closing tag (e.g. stray </div> that
    // doesn't match the currently-open tag's name) -- a DIFFERENT regex
    // from HTML_TAG_CLOSE is given here on purpose (anchored differently)
    // so Grammar-Kit's token-value dedup doesn't collapse them into one
    // constant the way it did the first time this was tried; the real
    // distinction is lexer-state-dependent, not regex-shape-dependent, so
    // this regex is decorative -- WtLexer.flex's hand-written rule is what
    // actually decides which of the two gets returned.
    HTML_TAG_CLOSE_MISMATCHED='regexp:</[a-zA-Z][a-zA-Z0-9]*\s*>!mismatched'

    // HTML/XML character entity references -- &amp; &#39; &#x27; etc.
    // See WikitextLexer.flex's ENTITY_REF/CHAR_ENTITY_REF macro comment
    // for why these get real tokens instead of being swallowed into
    // PLAIN_TEXT_RUN (downstream PageReader consumers may need to know
    // "this is an entity, decode it" rather than five literal chars).
    CHAR_ENTITY_REF='regexp:&#[0-9]+;|&#[xX][0-9a-fA-F]+;'
    ENTITY_REF='regexp:&[a-zA-Z][a-zA-Z0-9]*;'

    // HTML/XML-style comments <!-- ... -->. Content is NEVER rendered
    // (stricter than noinclude) so it's opaque -- COMMENT_CONTENT is
    // never re-parsed as wikitext, matching the lexer's COMMENT state
    // which pushes no recursive frame for what's inside, same treatment
    // as VERBATIM_CONTENT.
    COMMENT_START='regexp:<!--'
    COMMENT_END='regexp:-->'
    COMMENT_CONTENT='regexp:[^-]+|-[^-]|-'
  ]
}

wikitextFile ::= item*

private item ::= heading
               | list_item
               | table
               | template
               | paragraph
               | NEWLINE

// =========================================================================
// --- Headings ---
// =========================================================================
// H_START opens a heading FRAME in the lexer (FrameKind.HEADING) and
// H_END only ever gets emitted when that frame is the one on top of the
// stack AND is immediately followed by line-end -- see WikitextLexer.flex's
// H_START macro comment for the full reasoning (this replaces an earlier
// design that matched a whole heading LINE as one opaque token via
// whole-line regex; that approach broke on lines like
// "===== header <code>e=mc^2</code> {{sc|x}}", where the '=' inside
// <code> looked like a plausible closer to a naive regex but isn't one).
//
// Content between H_START and H_END is genuinely parsed via inline_item,
// so templates/links/tags inside headings produce real nested PSI (e.g.
// "== See [[Foo]] ==" gives you an actual internal_link child node, not
// just opaque heading text) -- this is what makes future highlighting/
// structure work on heading content possible.
//
// Level is derived from H_START's matched text length (number of '='
// chars after leading whitespace) via getLevel(), not stored as a
// separate token -- same "derive from leaf text in a generated accessor"
// pattern as before, just now the leaf is JUST the marker, not the whole
// line.
//
// An H_START with no matching H_END before NEWLINE/EOF is a genuine
// PARSE ERROR under this grammar (unterminated heading) -- the lexer
// already pops the HEADING frame and emits NEWLINE in that case (see
// closeHeadingFrameUnterminated in the .flex), so the parser sees
// "H_START inline_item* NEWLINE" with no H_END, which simply fails to
// match this rule and gets reported as a syntax error by Grammar-Kit's
// normal recovery -- which is exactly the desired fail-fast behavior,
// not a special case to code for.
heading ::= H_START inline_item* H_END {
  pin=1
  methods=[getLevel]
}

// =========================================================================
// --- Lists ---
// =========================================================================
// BULLET/NUMBERED/INDENT/DEF_TERM are real per-line-start tokens (lexer
// matches "{LINE_WS}{0,3} markerChar+" as one token each). Mixed markers
// like "*#" (bullet then sub-numbered) are represented as repeated marker
// tokens of different kinds, hence the (BULLET | NUMBERED | INDENT |
// DEF_TERM)+ rather than assuming a single marker kind per line.
list_item ::= (BULLET | NUMBERED | INDENT | DEF_TERM)+ paragraph_content {pin=1}

// =========================================================================
// --- Tables ---
// =========================================================================
// Minimal nesting-only grammar: TABLE_OPEN/TABLE_CLOSE bracket TABLE_CELL_SEP
// -delimited cells. Line-start-sensitive row/header syntax (|-, !, |+) is
// NOT modeled yet -- the lexer's <TABLE> state doesn't distinguish them
// from ordinary cell text, so they currently just fall into
// TABLE_CELL_TEXT. Revisit once the lexer grows that sensitivity.
table ::= TABLE_OPEN [ table_cell_content ] table_cell* TABLE_CLOSE {pin=1}
private table_cell ::= TABLE_CELL_SEP table_cell_content
private table_cell_content ::= (inline_item | TABLE_CELL_TEXT)*

// =========================================================================
// --- Templates ---
// =========================================================================
// The lexer's <TEMPLATE_NAME> state scans the name as ONE token
// ([^{}|]+ -> TEMPLATE_NAME) rather than as PLAIN_TEXT/SPACE runs the
// parser reassembles -- so template_name is consumed directly as a leaf
// token here, NOT re-parsed as a composite of smaller tokens (that was
// the old grammar's design, and it collided with this same TEMPLATE_NAME
// identifier -- seethe header comment above).
template ::= TEMPLATE_OPEN TEMPLATE_NAME (TEMPLATE_PIPE template_param)* TEMPLATE_CLOSE {pin=1}
private template_param ::= [ TEMPLATE_PARAM_TEXT TEMPLATE_EQUALS ] template_param_value
private template_param_value ::= (inline_item | TEMPLATE_PARAM_TEXT)*

// =========================================================================
// --- Paragraphs / generic inline content ---
// =========================================================================
paragraph ::= paragraph_content {pin=1}
private paragraph_content ::= inline_item+

// inline_item covers content that can appear inside templates, links,
// tables, paragraphs, and HTML tag bodies alike -- i.e. "ordinary wikitext"
// at any nesting depth. Bold/italic (apostrophe-counting) and external
// links ([url text]) are NOT included: the lexer doesn't tokenize
// FIVE_APOS/THREE_APOS/TWO_APOS/SINGLE_APOS or single LBRACK/RBRACK
// anywhere yet (those tokens are declared above for forward-compatibility
// with the lexer, but are currently dead -- see lexer/bnf cross-reference).
// Add them here once WikitextLexer.flex actually emits them.
inline_item ::= internal_link
              | html_tag
              | verbatim_tag
              | comment
              | template
              | PLAIN_TEXT
              | LINK_DISPLAY_TEXT
              | CHAR_ENTITY_REF
              | ENTITY_REF

// =========================================================================
// --- Links ---
// =========================================================================
// Internal Links: [[TargetPage]] or [[TargetPage|Display Text]]
// LINK_TARGET is matched whole by the lexer's <LINK_TARGET> state
// ([^\]|]+ -> LINK_TARGET), consumed directly as a leaf -- same reasoning
// as TEMPLATE_NAME above. link_display covers the post-PIPE portion,
// which the lexer tokenizes as LINK_DISPLAY_TEXT runs interleaved with
// nested constructs (links/templates/tags), hence reusing inline_item.
internal_link ::= LINK_OPEN LINK_TARGET (LINK_PIPE link_display)? LINK_CLOSE {pin=1}
private link_display ::= (inline_item | LINK_PIPE)*

// =========================================================================
// --- HTML / extension tags ---
// =========================================================================
// Self-closing tags (<ref name="x"/>) carry no content and push no lexer
// frame -- single-token leaf.
// Non-verbatim open/close pairs (<ref>...</ref>, <div>...</div>) wrap
// ordinary wikitext content recursively, matching the lexer's behavior of
// returning to the SAME state on open (see handleOpenTag in the .flex).
html_tag ::= HTML_TAG_SELFCLOSE
           | HTML_TAG_OPEN html_tag_content HTML_TAG_CLOSE {pin=1}
private html_tag_content ::= inline_item*

// Verbatim tags (<nowiki>, <pre>, <syntaxhighlight>, etc.) -- content is
// opaque VERBATIM_CONTENT runs, never re-parsed as wikitext, matching the
// lexer's <VERBATIM_TAG> state which never pushes a recursive frame for
// what's inside.
verbatim_tag ::= HTML_TAG_OPEN verbatim_run* HTML_TAG_CLOSE {pin=1}
private verbatim_run ::= VERBATIM_CONTENT

// =========================================================================
// --- Comments ---
// =========================================================================
// <!-- ... --> content is opaque, never re-parsed as wikitext, matching
// the lexer's COMMENT state (see WikitextLexer.flex). Unlike noinclude/
// includeonly, comment content is NEVER rendered under any circumstance --
// not even conditionally -- so there's no reason to parse a {{template}}
// or [[link]] that happens to appear inside one.
comment ::= COMMENT_START comment_run* COMMENT_END {pin=1}
private comment_run ::= COMMENT_CONTENT
