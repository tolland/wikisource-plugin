<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.WtFileType"
            fieldName="INSTANCE"
            language="Wikitext"
            extensions="wt;wiki"
        />

        <fileType
            name="proofread-page"
            implementationClass="org.limepepper.lang.wikitext.PrpFileType"
            fieldName="INSTANCE"
            language="Wikitext"
            extensions="prp"
        />

        <lang.parserDefinition
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.parser.WtParserDefinition"
        />
    </extensions>
</idea-plugin>
