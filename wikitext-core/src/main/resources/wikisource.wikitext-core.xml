<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.WtFileType"
            fieldName="INSTANCE"
            language="Wikitext"
            extensions="wt;wiki"
        />

        <fileType
            name="proofread-page"
            implementationClass="org.limepepper.lang.wikitext.PrpFileType"
            fieldName="INSTANCE"
            language="Wikitext"
            extensions="prp"
        />

        <lang.parserDefinition
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.parser.WtParserDefinition"
        />

        <lang.elementManipulator
            forClass="org.limepepper.lang.wikitext.psi.WtVerbatimBody"
            implementationClass="org.limepepper.lang.wikitext.psi.impl.WtVerbatimBodyManipulator"
        />

        <multiHostInjector
            implementation="org.limepepper.lang.wikitext.injection.WtVerbatimLanguageInjector"
        />
    </extensions>

<!--    <extensions defaultExtensionNs="org.intellij.intelliLang">-->
<!--        <injectionConfig-->
<!--            config="path/to/your/injections.xml"-->
<!--        />-->
<!--    </extensions>-->
</idea-plugin>
