<idea-plugin>
    <dependencies>
        <module name="wikisource.wikitext-core"/>
        <module name="wikisource.wikitext-vfs"/>
        <module name="intellij.platform.ui.jcef"/>
        <module name="intellij.libraries.jcef"/>
        <module name="intellij.platform.structureView"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <lang.syntaxHighlighterFactory
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.highlighting.WtSyntaxHighlighterFactory"
        />

<!--        <annotator-->
<!--            language="Wikitext"-->
<!--            implementationClass="org.limepepper.lang.wikitext.highlighting.WtAnnotator"-->
<!--        />-->

        <annotator
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.annotator.WtSentenceBandAnnotator"/>

        <defaultLiveTemplates
            file="/liveTemplates/Wikitext.xml"
        />

        <liveTemplateContext
            contextId="WIKITEXT"
            implementation="org.limepepper.lang.wikitext.templates.WtContextType"
        />

        <facetType
            implementation="org.limepepper.lang.wikitext.facet.WtFacetType"
        />

        <toolWindow
            id="MyToolWindow"
            icon="AllIcons.Toolwindows.ToolWindowPalette"
            factoryClass="org.limepepper.lang.wikitext.tool.MyToolWindowFactory"
            anchor="right"
        />

        <!-- OCR review surface: responses land here for preview before any
        text is applied (see OcrReviewController for the boundary). -->
        <toolWindow
            id="Wikisource OCR"
            icon="AllIcons.Actions.Preview"
            factoryClass="org.limepepper.lang.wikitext.ocr.OcrToolWindowFactory"
            anchor="bottom"
            canCloseContents="true"
        />

        <!-- Text editing: Surround With (Ctrl+Alt+T). Language-scoped, so it
        covers plain .wt files and wikisource:// files alike — the feature only
        ever touches the Document. -->
        <lang.surroundDescriptor
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.editing.surround.WtSurroundDescriptor"
        />

        <!-- Prototype switches for the editing features (see WtEditingFlags).
        Registry, not Settings: none of these interaction styles has earned a
        checkbox yet, and each is expected to be deleted along with its losing
        implementation. Toggle from Help > Find Action > "Registry...". -->
        <registryKey
            key="wikitext.editing.surround.enabled"
            defaultValue="true"
            description="Wikitext: contribute wikitext tags to Surround With (Ctrl+Alt+T)"
        />
        <registryKey
            key="wikitext.editing.surround.strategy"
            defaultValue="template"
            description="Wikitext: how Surround With inserts markup - 'template' (live template, mirrors section names) or 'document' (plain document edit)"
        />
        <!-- Puts the bold/italic actions ahead of the platform actions that
        share their shortcuts. See WtEditingActionPromoter for why disabling
        the platform action is not sufficient on its own. -->
        <actionPromoter
            order="last"
            implementation="org.limepepper.lang.wikitext.editing.toggle.WtEditingActionPromoter"
        />

        <registryKey
            key="wikitext.editing.toggle.enabled"
            defaultValue="true"
            description="Wikitext: enable the bold/italic toggle actions (Ctrl+B / Ctrl+I)"
        />
        <registryKey
            key="wikitext.editing.toggle.promote"
            defaultValue="true"
            description="Wikitext: let the wikitext bold/italic actions win Ctrl+B / Ctrl+I over Go To Declaration / Implement Methods in wikitext files"
        />
        <registryKey
            key="wikitext.editing.preview.mode"
            defaultValue="both"
            description="Wikitext: which preview(s) a ProofreadPage editor opens showing - 'both', 'image' (reference scan only), or 'render'"
        />
        <registryKey
            key="wikitext.editing.preview.splitStacked"
            defaultValue="true"
            description="Wikitext: when both previews are shown, tile them stacked (scan above render) rather than side by side"
        />
        <registryKey
            key="wikitext.editing.variablePrompt"
            defaultValue="inline"
            description="Wikitext: how a tag's value (e.g. a section name) is asked for - 'inline' (type in the editor), 'dialog' (modal input), or 'none' (insert a placeholder)"
        />

        <lang.psiStructureViewFactory
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.structure.WtStructureViewFactory"
        />

        <!-- pure Proofread-page editor, separate for dev purposes -->
        <fileEditorProvider
            implementation="org.limepepper.lang.wikitext.editor.prp.PrpFileEditorProvider"
        />

        <!--
        this is the old editor that uses profiles to build
        a Page, Index or generic wikitext specific editor/preview split
        -->
        <fileEditorProvider
            implementation="org.limepepper.lang.wikitext.preview.WtPreviewEditorProvider"
        />

        <!-- this is a stub to provide inlay hints around specific wikisource
        related psi elements, however, it is disabled because it is messing up
        the inlay hints in the proofread-page text editor -->
        <!--        <codeInsight.inlayProvider-->
        <!--            language="Wikitext"-->
        <!--            implementationClass="org.limepepper.lang.wikitext.inlay.ProofreadInlayProvider"-->
        <!--        />-->

    </extensions>

    <actions>
        <!-- Formatting toggles. The shortcuts collide with Go To Declaration
        (Ctrl+B) and Implement Methods (Ctrl+I) on purpose: they are what every
        other editor uses for bold/italic. The actions hide themselves outside
        wikitext files, and WtEditingActionPromoter decides the tie inside
        them. -->
        <action
            id="org.limepepper.lang.wikitext.editing.toggle.WtToggleBoldAction"
            class="org.limepepper.lang.wikitext.editing.toggle.WtToggleBoldAction"
            text="Bold"
            description="Wrap the selection in ''' ''' (or unwrap it)">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control B"/>
        </action>
        <action
            id="org.limepepper.lang.wikitext.editing.toggle.WtToggleItalicAction"
            class="org.limepepper.lang.wikitext.editing.toggle.WtToggleItalicAction"
            text="Italic"
            description="Wrap the selection in '' '' (or unwrap it)">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control I"/>
        </action>

        <action
            id="org.limepepper.lang.wikitext.editor.prp.CreateTextRangeAction"
            class="org.limepepper.lang.wikitext.editor.prp.CreateTextRangeAction"
            text="Save Text Range"
            description="Save the selected text (or the caret position) as a persistable text range"
            icon="AllIcons.General.Add">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift T"/>
        </action>
    </actions>

    <!--    <applicationListeners>-->
    <!-- this is a stub for listing to EditorFactory events -->
    <!--        <listener-->
    <!--            class="org.limepepper.lang.wikitext.inlay.ProofreadEditorListener"-->
    <!--            topic="com.intellij.openapi.editor.event.EditorFactoryListener"-->
    <!--        />-->
    <!--    </applicationListeners>-->
</idea-plugin>
