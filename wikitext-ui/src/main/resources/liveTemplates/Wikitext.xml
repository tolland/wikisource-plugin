<templateSet group="Wikitext">
    <template name="{" value="[$TEXT$]($LINK$)$END$" description="SDK: New link reference" toReformat="false"
              toShortenFQNames="false">
        <variable name="TEXT" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="LINK" expression="complete()" defaultValue="" alwaysStopAt="true"/>
        <context/>
    </template>
    <template name="{{" value="{{$NAME$|$PARAM$|$TEXT$}}$END$" description="open template transclusion" toReformat="false" toShortenFQNames="true">
        <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true" />
        <variable name="PARAM" expression="" defaultValue="" alwaysStopAt="true" />
        <variable name="TEXT" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="WIKITEXT" value="true"/>
        </context>
    </template>
    <template name="{{ne" value="{{ne&#10;|1=$LEFTITEM$&#10;|2=&lt;math&gt;$MIDITEM$&lt;/math&gt;&#10;|3=$RIGHTITEM$&#10;}}&#10;$END$" description="insert numerical equation template" toReformat="false" toShortenFQNames="true">
        <variable name="LEFTITEM" expression="" defaultValue="" alwaysStopAt="true" />
        <variable name="MIDITEM" expression="complete()" defaultValue="" alwaysStopAt="true" />
        <variable name="RIGHTITEM" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="WIKITEXT" value="true" />
        </context>
    </template>
    <template name="{{ne-surround" value="{{ne&#10;|1=$LEFTITEM$&#10;|2=$SELECTION$&#10;|3=$RIGHTITEM$&#10;}}&#10;$END$" description="insert numerical equation template" toReformat="false" toShortenFQNames="true">
        <variable name="LEFTITEM" expression="" defaultValue="" alwaysStopAt="true" />
        <variable name="RIGHTITEM" expression="" defaultValue="" alwaysStopAt="true" />
        <context>
            <option name="WIKITEXT" value="true" />
        </context>
    </template>
</templateSet>
