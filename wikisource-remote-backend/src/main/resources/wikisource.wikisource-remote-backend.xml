<idea-plugin>
    <dependencies>
        <plugin id="org.limepepper.lang.wikitext"/>
        <module name="wikisource.wikisource-remote-shared"/>
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">
        <fileDocumentManagerListener
            implementation="org.limepepper.lang.wikitext.vfs.WtManagedDocumentListener"/>

        <!--suppress JetBrainsInternalExtensionsUsage -->
        <virtualFileSystem
            key="wikisource-wtbot"
            implementationClass="org.limepepper.lang.wikitext.vfs.WtManagedBackendFileSystem"/>

        <fileTypeOverrider
            implementation="org.limepepper.lang.wikitext.vfs.WtManagedFileTypeOverrider"/>

        <applicationService
            serviceImplementation="org.limepepper.lang.wikitext.vfs.backend.WtVfsService"
        />

        <applicationService
            serviceInterface="org.limepepper.wikisource.remote.rpc.WtRemotePageRpcService"
            serviceImplementation="org.limepepper.wikisource.remote.rpc.WtRemotePageRpcServiceImpl"
        />

        <applicationService
            serviceImplementation="org.limepepper.lang.wikitext.vfs.settings.WtbotAppSettings"
        />

        <!-- Application-scoped: wtbot mediates between wikis, so one sidecar
             serves every project, and the VFS it backs is an app singleton. -->
        <applicationConfigurable
            id="org.limepepper.wikitext.wtbot"
            parentId="tools"
            displayName="WTBot (VFS backend)"
            instance="org.limepepper.lang.wikitext.vfs.settings.WtbotConfigurable"/>

        <!-- Project-level, but the page edits the application defaults
             instead when the project hasn't opted into its own list, so
             what's on screen is always what this project will get. -->
        <projectConfigurable
            id="org.limepepper.wikitext.ocr.favorites"
            parentId="tools"
            displayName="OCR Favourites"
            instance="org.limepepper.lang.wikitext.vfs.settings.OcrFavoritesConfigurable"
        />

    </extensions>
</idea-plugin>
