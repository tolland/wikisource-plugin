<idea-plugin>
    <dependencies>
        <module name="wikisource.wikitext-core"/>
        <module name="intellij.platform.structureView"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="editor"
            id="org.limepepper.wikitext.highlighting"
            displayName="Wikitext Highlighting"
            instance="org.limepepper.lang.wikitext.settings.WtHighlightingConfigurable"/>

        <lang.syntaxHighlighterFactory
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.highlighting.WtSyntaxHighlighterFactory"
        />

        <annotator
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.annotator.WtSentenceBandAnnotator"/>

        <annotator
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.annotator.WtReferenceAnnotator"/>

        <defaultLiveTemplates
            file="/liveTemplates/Wikitext.xml"
        />

        <liveTemplateContext
            contextId="WIKITEXT"
            implementation="org.limepepper.lang.wikitext.templates.WtContextType"
        />

        <!-- Text editing: Surround With (Ctrl+Alt+T). Language-scoped, so it
        covers plain .wt files and wikisource-wtbot:// files alike — the feature only
        ever touches the Document. -->
        <lang.surroundDescriptor
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.editing.surround.WtSurroundDescriptor"
        />

        <!-- Prototype switches for the editing features (see WtEditingFlags).
        Registry, not Settings: none of these interaction styles has earned a
        checkbox yet, and each is expected to be deleted along with its losing
        implementation. Toggle from Help > Find Action > "Registry...". -->
        <registryKey
            key="wikitext.editing.surround.enabled"
            defaultValue="true"
            description="Wikitext: contribute wikitext tags to Surround With (Ctrl+Alt+T)"
        />
        <registryKey
            key="wikitext.editing.surround.strategy"
            defaultValue="template"
            description="Wikitext: how Surround With inserts markup - 'template' (live template, mirrors section names) or 'document' (plain document edit)"
        />
        <!-- Puts the bold/italic actions ahead of the platform actions that
        share their shortcuts. See WtEditingActionPromoter for why disabling
        the platform action is not sufficient on its own. -->
        <actionPromoter
            order="last"
            implementation="org.limepepper.lang.wikitext.editing.toggle.WtEditingActionPromoter"
        />

        <registryKey
            key="wikitext.editing.toggle.enabled"
            defaultValue="true"
            description="Wikitext: enable the bold/italic toggle actions (Ctrl+B / Ctrl+I)"
        />
        <registryKey
            key="wikitext.editing.toggle.promote"
            defaultValue="true"
            description="Wikitext: let the wikitext bold/italic actions win Ctrl+B / Ctrl+I over Go To Declaration / Implement Methods in wikitext files"
        />
        <registryKey
            key="wikitext.editing.variablePrompt"
            defaultValue="inline"
            description="Wikitext: how a tag's value (e.g. a section name) is asked for - 'inline' (type in the editor), 'dialog' (modal input), or 'none' (insert a placeholder)"
        />

        <lang.psiStructureViewFactory
            language="Wikitext"
            implementationClass="org.limepepper.lang.wikitext.structure.WtStructureViewFactory"
        />
    </extensions>

    <actions>
        <!-- Formatting toggles. The shortcuts collide with Go To Declaration
        (Ctrl+B) and Implement Methods (Ctrl+I) on purpose: they are what every
        other editor uses for bold/italic. The actions hide themselves outside
        wikitext files, and WtEditingActionPromoter decides the tie inside
        them. -->
        <action
            id="org.limepepper.lang.wikitext.editing.toggle.WtToggleBoldAction"
            class="org.limepepper.lang.wikitext.editing.toggle.WtToggleBoldAction"
            text="Bold"
            description="Wrap the selection in ''' ''' (or unwrap it)">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control B"/>
        </action>
        <action
            id="org.limepepper.lang.wikitext.editing.toggle.WtToggleItalicAction"
            class="org.limepepper.lang.wikitext.editing.toggle.WtToggleItalicAction"
        >
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control I"/>
        </action>
    </actions>
    <resource-bundle>messages.WikitextBundle</resource-bundle>
</idea-plugin>
