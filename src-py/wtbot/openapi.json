{
  "openapi": "3.1.0",
  "info": {
    "title": "wtbot VFS API",
    "version": "0.1.0"
  },
  "paths": {
    "/vfs/children": {
      "get": {
        "tags": [
          "vfs"
        ],
        "summary": "List Children",
        "description": "VFS getChildren(). Reads cached rows from SQLite; does not fetch from wiki.",
        "operationId": "list_children_vfs_children_get",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Parent node path",
              "title": "Path"
            },
            "description": "Parent node path"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListChildrenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vfs/content": {
      "get": {
        "tags": [
          "vfs"
        ],
        "summary": "Read Content",
        "description": "VFS contentsToByteArray()/getInputStream().",
        "operationId": "read_content_vfs_content_get",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadContentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "vfs"
        ],
        "summary": "Write Content",
        "description": "VFS setBinaryContent(). Enqueues a commit; conflict surfaced in status.",
        "operationId": "write_content_vfs_content_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vfs/stat": {
      "get": {
        "tags": [
          "vfs"
        ],
        "summary": "Stat",
        "description": "Cheap metadata probe -- timestamp/length/revid/exists without body.",
        "operationId": "stat_vfs_stat_get",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stat"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vfs/rename": {
      "post": {
        "tags": [
          "vfs"
        ],
        "summary": "Rename",
        "description": "VFS renameFile(). On the wiki this is a page move via pywikibot.",
        "operationId": "rename_vfs_rename_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vfs/delete": {
      "post": {
        "tags": [
          "vfs"
        ],
        "summary": "Delete",
        "description": "VFS deleteFile(). Likely returns status=unsupported for most namespaces.",
        "operationId": "delete_vfs_delete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vfs/child": {
      "post": {
        "tags": [
          "vfs"
        ],
        "summary": "Create Child",
        "description": "VFS createChildFile()/createChildDirectory().",
        "operationId": "create_child_vfs_child_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChildRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vfs/changes": {
      "get": {
        "tags": [
          "vfs"
        ],
        "summary": "Changes Since",
        "description": "Poll endpoint driving the plugin's refresh loop. Renames/moves are\nreported with old_path + stable_id so the plugin preserves node identity.",
        "operationId": "changes_since_vfs_changes_get",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from previous poll; None = from start",
              "title": "Cursor"
            },
            "description": "Opaque cursor from previous poll; None = from start"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesSinceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Change": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ChangeKind"
          },
          "stable_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stable Id",
            "description": "Identity key; ties a rename/move's old and new paths to one node."
          },
          "path": {
            "type": "string",
            "title": "Path",
            "description": "New/current path of the affected node."
          },
          "old_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Old Path",
            "description": "Required for kind in (rename, move). The plugin uses (old_path -> path) to fire VFilePropertyChangeEvent(PROP_NAME)/VFileMoveEvent and keep the open editor's identity, instead of a delete+create that would invalidate it."
          },
          "revid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revid"
          },
          "requestor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestor",
            "description": "Null if externally originated; set if this echoes a plugin-initiated op."
          }
        },
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "title": "Change",
        "description": "One remote-originated change since the caller's cursor. The plugin maps\neach to the corresponding VFileEvent and a VirtualFile.refresh() call."
      },
      "ChangeKind": {
        "type": "string",
        "enum": [
          "create",
          "delete",
          "content",
          "rename",
          "move"
        ],
        "title": "ChangeKind"
      },
      "ChangesSinceResponse": {
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "type": "array",
            "title": "Changes"
          },
          "next_cursor": {
            "type": "string",
            "title": "Next Cursor",
            "description": "Opaque; pass back as `cursor` on the next poll."
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "changes",
          "next_cursor"
        ],
        "title": "ChangesSinceResponse",
        "description": "Cursor-paginated. The plugin's background poller calls this on an\ninterval (the same poll discussed for local_modified_at, just over HTTP)\nand replays the changes into the platform on the EDT in a write action."
      },
      "CreateChildRequest": {
        "properties": {
          "parent_path": {
            "type": "string",
            "title": "Parent Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/NodeKind"
          }
        },
        "type": "object",
        "required": [
          "parent_path",
          "name",
          "kind"
        ],
        "title": "CreateChildRequest"
      },
      "DeleteRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "requestor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestor"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "DeleteRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ListChildrenResponse": {
        "properties": {
          "parent_path": {
            "type": "string",
            "title": "Parent Path"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "parent_path",
          "children"
        ],
        "title": "ListChildrenResponse"
      },
      "Node": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "wikisource://-relative path, uniquely identifies the node"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/NodeKind"
          },
          "stable_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stable Id",
            "description": "MediaWiki pageid; survives renames. None until first remote fetch."
          },
          "revid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revid",
            "description": "Revision id as of last fetch; the conflict token."
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp",
            "description": "Drives VirtualFile.getTimeStamp(). Reflects local_modified_at, NOT remote revision time -- see schema model notes."
          },
          "length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Length",
            "description": "Content length in bytes; None for directories."
          },
          "writable": {
            "type": "boolean",
            "title": "Writable",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "path",
          "name",
          "kind"
        ],
        "title": "Node",
        "description": "One entry as the VFS sees it. `stable_id` is the rename-survival key\n(MediaWiki pageid) -- distinct from `path`, which changes on rename."
      },
      "NodeKind": {
        "type": "string",
        "enum": [
          "file",
          "directory"
        ],
        "title": "NodeKind"
      },
      "OperationResult": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OperationStatus"
          },
          "node": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Node"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "OperationResult"
      },
      "OperationStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error",
          "unsupported"
        ],
        "title": "OperationStatus"
      },
      "ReadContentResponse": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "revid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revid"
          },
          "content_base64": {
            "type": "string",
            "title": "Content Base64"
          }
        },
        "type": "object",
        "required": [
          "path",
          "content_base64"
        ],
        "title": "ReadContentResponse"
      },
      "RenameRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "new_name": {
            "type": "string",
            "title": "New Name"
          },
          "requestor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestor",
            "description": "Echoed back on the resulting change-feed entry so the plugin can tell its own initiated rename from an externally-detected one (null requestor == external change, mirroring VFS getRequestor() semantics)."
          }
        },
        "type": "object",
        "required": [
          "path",
          "new_name"
        ],
        "title": "RenameRequest"
      },
      "Stat": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "exists": {
            "type": "boolean",
            "title": "Exists"
          },
          "kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "stable_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stable Id"
          },
          "revid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revid"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Length"
          }
        },
        "type": "object",
        "required": [
          "path",
          "exists"
        ],
        "title": "Stat"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WriteContentRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "content_base64": {
            "type": "string",
            "title": "Content Base64"
          },
          "base_revid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Revid",
            "description": "Revid the edit is based on -- sent as basetimestamp/conflict token. A mismatch against current remote state is an edit conflict, surfaced as WriteResult.status='conflict', not an error."
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "path",
          "content_base64"
        ],
        "title": "WriteContentRequest"
      },
      "WriteResult": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "status": {
            "$ref": "#/components/schemas/WriteStatus"
          },
          "new_revid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "New Revid"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "title": "WriteResult"
      },
      "WriteStatus": {
        "type": "string",
        "enum": [
          "ok",
          "conflict",
          "error"
        ],
        "title": "WriteStatus"
      }
    }
  }
}