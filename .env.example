# wtbot sidecar configuration — copy to .env next to where uvicorn runs.
# Read once at startup (see src-py/wtbot/logging_config.py and docs/logging.md);
# restart `fastapi dev` after changing.

# --- logging -----------------------------------------------------------------

# Root logger level: TRACE, DEBUG, INFO (default), WARNING, ERROR — or a number.
#WTBOT_LOG_LEVEL=DEBUG

# SQL statement logging: true (statements) or debug (statements + result rows).
#WTBOT_SQLALCHEMY_ECHO=true

# Request/response body tracing per router tag (see KNOWN_DEBUG_ROUTE_TAGS in
# wtbot/logging_config.py for the full tag list), or all routers at once.
#WTBOT_TRACE_DEBUG_ROUTE_TAGS=vfs,preview,page-images
#WTBOT_TRACE_ALL_DEBUG_ROUTES=true

# Truncation limit for traced bodies in bytes; 0 = unlimited. Default 131072.
#WTBOT_DEBUG_ROUTE_BODY_LIMIT_BYTES=0

# --- storage -----------------------------------------------------------------

#WTBOT_DATABASE_URL=sqlite:///database.db
#WTBOT_BLOB_ROOT=./blobs
