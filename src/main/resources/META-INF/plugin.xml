<idea-plugin>
    <id>org.limepepper.lang.wikitext</id>
    <name>Wikisource</name>

    <vendor url="https://www.mycompany.com">The developer</vendor>
    <description><![CDATA[
    Support wikitext via lsp or lexer. <em>This description must be at least 40 characters.</em>
        ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.jcef</depends>

    <content>
        <module name="wikisource.wikitext-core" loading="required"/>
        <module name="wikisource.wikitext-vfs"/>
        <module name="wikisource.wikitext-ui"/>
    </content>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            id="org.limepepper.wikitext.wtbot.project"
            displayName="WTBot (VFS backend)"
            instance="org.limepepper.lang.wikitext.vfs.settings.WtbotProjectConfigurable"/>
    </extensions>
</idea-plugin>
