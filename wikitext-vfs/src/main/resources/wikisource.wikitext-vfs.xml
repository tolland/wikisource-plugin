<idea-plugin>
    <dependencies>
        <module name="wikisource.wikitext-core"/>
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">

        <virtualFileSystem
            key="wikisource"
            implementationClass="org.limepepper.lang.wikitext.vfs.WtVirtualFileSystem"
        />

        <applicationService
            serviceImplementation="org.limepepper.lang.wikitext.vfs.backend.WtVfsService"
        />

        <projectConfigurable
            id="org.limepepper.wikitext.wtbot.project"
            displayName="WTBot (VFS backend)"
            instance="org.limepepper.lang.wikitext.vfs.settings.WtbotProjectConfigurable"/>

    </extensions>
</idea-plugin>
