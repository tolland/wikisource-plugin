# Local-only overrides for the containerized Wikimedia OCR instance. No
# Google Vision keyfile / Transkribus credentials on purpose -- this
# harness only exercises the free/local Tesseract engine.
APP_ENV=prod
APP_IMAGE_HOSTS=upload.wikimedia.org,upload.wikimedia.beta.wmflabs.org,wikisource-debian-13.lan
MAILER_DSN=null://null
VERIFTY_PEER=false
VERIFY_HOST=false
CURLOPT_SSL_VERIFYHOST=false
APP_DEBUG=1
verify_host=false
verify_peer=false
